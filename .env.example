# Account identifier, e.g. myorg-myaccount (find it in Snowsight > Account > Account details)
SNOWFLAKE_ACCOUNT=

# Key-pair authentication with the service user (target: dev)
SNOWFLAKE_SERVICE_USER=ATTIO_CANDIDATE_SVC
SNOWFLAKE_PRIVATE_KEY_PATH=~/.ssh/snowflake_rsa_key.p8
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

# Password + MFA with your Snowsight user (target: dev_password)
SNOWFLAKE_USER=ATTIO_CANDIDATE
SNOWFLAKE_PASSWORD=
